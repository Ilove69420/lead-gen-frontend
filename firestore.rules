rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // A logged-in user can read only their own role document.
      // Nobody can write from the client — accounts/roles are only
      // ever created by the backend's admin-only /api/users/create.
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
